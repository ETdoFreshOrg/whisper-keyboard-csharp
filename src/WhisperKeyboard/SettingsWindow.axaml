<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WhisperKeyboard.SettingsWindow"
        Title="Whisper Keyboard Settings"
        Width="450"
        Height="420"
        WindowStartupLocation="CenterScreen"
        CanResize="False">

    <Grid RowDefinitions="*,Auto">
        <TabControl x:Name="MainTabControl" Grid.Row="0" Margin="10">

            <!-- Audio Tab -->
            <TabItem Header="Audio">
                <ScrollViewer Margin="10">
                    <StackPanel Spacing="15">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Audio Device" FontSize="12" Foreground="#888888"/>
                            <ComboBox x:Name="DeviceBox" HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="Voice Detection Threshold" FontSize="12" Foreground="#888888"/>
                                <TextBlock x:Name="ThresholdLabel" DockPanel.Dock="Right" Text="500" FontSize="12" Foreground="#888888"/>
                            </DockPanel>
                            <Slider x:Name="ThresholdSlider" Minimum="10" Maximum="5000" Value="500"/>
                            <Border Background="#141414" CornerRadius="3" Height="16" ClipToBounds="True">
                                <Canvas x:Name="VolumeMeterCanvas" />
                            </Border>
                            <TextBlock Text="Yellow line = threshold. Green = below, Red = above (speech detected)." FontSize="10" Foreground="#666666"/>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="Min Audio Duration (seconds)" FontSize="12" Foreground="#888888"/>
                            <NumericUpDown x:Name="MinAudioDuration" Minimum="0.5" Maximum="10" Value="1" Increment="0.1" FormatString="F1"/>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="Max Silence Duration (seconds)" FontSize="12" Foreground="#888888"/>
                            <NumericUpDown x:Name="MaxSilenceDuration" Minimum="0.3" Maximum="5" Value="1" Increment="0.1" FormatString="F1"/>
                        </StackPanel>

                        <Border BorderBrush="#333333" BorderThickness="0,1,0,0" Margin="0,5,0,0" Padding="0,10,0,0">
                            <StackPanel Spacing="15">
                                <StackPanel Spacing="5">
                                    <CheckBox x:Name="PreRollEnabledCheck" Content="Enable pre-roll (keep mic always on)"/>
                                    <TextBlock Text="Captures audio from just before you start talking or press push-to-talk. Keeps the microphone running while idle so nothing is missed. Disable to let the mic shut off when not in use."
                                               FontSize="10" Foreground="#666666" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Spacing="5">
                                    <TextBlock Text="Pre-roll Duration (seconds)" FontSize="12" Foreground="#888888"/>
                                    <NumericUpDown x:Name="PreRollSeconds" Minimum="0" Maximum="5" Value="1" Increment="0.1" FormatString="F1"/>
                                </StackPanel>

                                <StackPanel Spacing="5">
                                    <TextBlock Text="Post-roll Duration (seconds)" FontSize="12" Foreground="#888888"/>
                                    <NumericUpDown x:Name="PostRollSeconds" Minimum="0" Maximum="5" Value="1" Increment="0.1" FormatString="F1"/>
                                    <TextBlock Text="Keeps recording briefly after you stop talking or release push-to-talk."
                                               FontSize="10" Foreground="#666666" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Speech-to-text Tab -->
            <TabItem Header="Speech">
                <ScrollViewer Margin="10">
                    <StackPanel Spacing="15">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Speech-to-text backends (tried top to bottom)" FontSize="12" Foreground="#888888"/>
                            <StackPanel x:Name="BackendListPanel" Spacing="6"/>
                            <TextBlock Text="ChatGPT uses your Codex sign-in. If one fails, the next is tried and the clip is kept until one works."
                                       FontSize="10" Foreground="#666666" TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock Text="Your server" FontSize="13" FontWeight="SemiBold"/>

                        <StackPanel Spacing="5">
                            <TextBlock Text="API Provider" FontSize="12" Foreground="#888888"/>
                            <ComboBox x:Name="ApiProviderBox" SelectedIndex="0">
                                <ComboBoxItem Content="stt.etdofresh.com" Tag="https://stt.etdofresh.com"/>
                                <ComboBoxItem Content="OpenAI" Tag="https://api.openai.com"/>
                                <ComboBoxItem Content="Custom..." Tag="custom"/>
                            </ComboBox>
                            <TextBox x:Name="ApiBaseUrlBox" Watermark="https://your-custom-endpoint.com" IsVisible="False"/>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="Model" FontSize="12" Foreground="#888888"/>
                            <TextBox x:Name="ModelBox" Watermark="whisper-1"/>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="API Key" FontSize="12" Foreground="#888888"/>
                            <TextBox x:Name="ApiKeyBox" PasswordChar="*" Watermark="sk-..."/>
                            <TextBlock Text="Or set OPENAI_API_KEY environment variable" FontSize="10" Foreground="#666666"/>
                        </StackPanel>

                        <CheckBox x:Name="ShowApiKeyCheck" Content="Show API Key"/>

                        <StackPanel Spacing="5">
                            <Button x:Name="TestEndpointButton" Content="Test endpoint" HorizontalAlignment="Left" Click="OnTestEndpointClick"/>
                            <TextBlock x:Name="TestEndpointStatus" Text="" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="Language" FontSize="12" Foreground="#888888"/>
                            <ComboBox x:Name="LanguageBox" SelectedIndex="0">
                                <ComboBoxItem Content="Auto-detect" Tag="auto"/>
                                <ComboBoxItem Content="English" Tag="en"/>
                                <ComboBoxItem Content="Spanish" Tag="es"/>
                                <ComboBoxItem Content="French" Tag="fr"/>
                                <ComboBoxItem Content="German" Tag="de"/>
                                <ComboBoxItem Content="Italian" Tag="it"/>
                                <ComboBoxItem Content="Portuguese" Tag="pt"/>
                                <ComboBoxItem Content="Russian" Tag="ru"/>
                                <ComboBoxItem Content="Japanese" Tag="ja"/>
                                <ComboBoxItem Content="Korean" Tag="ko"/>
                                <ComboBoxItem Content="Chinese" Tag="zh"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Typing Tab -->
            <TabItem Header="Typing">
                <ScrollViewer Margin="10">
                    <StackPanel Spacing="15">
                        <CheckBox x:Name="PasteModeCheck" Content="Use Paste Mode (faster, uses clipboard)" IsChecked="True"/>

                        <StackPanel Spacing="5">
                            <TextBlock Text="Typing Delay (ms per character)" FontSize="12" Foreground="#888888"/>
                            <NumericUpDown x:Name="TypingDelayMsBox" Minimum="0" Maximum="500" Value="0" Increment="1" FormatString="0"/>
                            <TextBlock Text="0 = batch send (fastest). Increase if characters are clumped/dropped in some apps. Only applies in Typing mode." FontSize="10" Foreground="#666666"/>
                        </StackPanel>

                        <CheckBox x:Name="UseVirtualSpaceKeyCheck" Content="Use VK_SPACE for spaces (more reliable in terminals/Claude Code)"/>

                        <StackPanel x:Name="VirtualSpaceHoldPanel" Spacing="5" Margin="20,0,0,0" IsVisible="False">
                            <TextBlock Text="Space key hold time (ms)" FontSize="12" Foreground="#888888"/>
                            <NumericUpDown x:Name="VirtualSpaceHoldMsBox" Minimum="0" Maximum="200" Value="5" Increment="1" FormatString="0"/>
                            <TextBlock Text="Time between key down and key up for spaces. Default 5ms. Lower = faster but may drop spaces; higher = more reliable." FontSize="10" Foreground="#666666"/>
                        </StackPanel>

                        <CheckBox x:Name="PunctuationCheck" Content="Auto-add punctuation at end of sentences" IsChecked="True"/>
                        <CheckBox x:Name="CapitalizeCheck" Content="Capitalize first letter of sentences" IsChecked="True"/>
                        <CheckBox x:Name="AutoEnterCheck" Content="Auto-press Enter after typing"/>

                        <StackPanel Spacing="5">
                            <CheckBox x:Name="ExitWordsCheck" Content="Enable exit words (press Enter when spoken)" IsChecked="True"/>
                            <TextBox x:Name="ExitWordsBox" Watermark="over, enter, submit" Margin="20,0,0,0"/>
                            <TextBlock Text="Words are removed from text, then Enter is pressed" FontSize="10" Foreground="#666666" Margin="20,0,0,0"/>
                        </StackPanel>

                        <StackPanel Spacing="5" Margin="0,15,0,0">
                            <CheckBox x:Name="WakeWordsCheck" Content="Enable wake/pause words (voice-activated mode)"/>

                            <StackPanel Spacing="5" Margin="20,5,0,0">
                                <TextBlock Text="Wake words (activate from standby):" FontSize="12" Foreground="#888888"/>
                                <TextBox x:Name="WakeWordsBox" Watermark="start listening, hey whisper"/>
                                <TextBlock Text="Say at the beginning to start transcribing" FontSize="10" Foreground="#666666"/>
                            </StackPanel>

                            <StackPanel Spacing="5" Margin="20,10,0,0">
                                <TextBlock Text="Pause words (return to standby):" FontSize="12" Foreground="#888888"/>
                                <TextBox x:Name="PauseWordsBox" Watermark="stop listening, go to sleep"/>
                                <TextBlock Text="Say ONLY this phrase to pause" FontSize="10" Foreground="#666666"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Hotkeys Tab -->
            <TabItem Header="Hotkeys">
                <ScrollViewer Margin="10">
                    <StackPanel Spacing="15">
                        <TextBlock Text="Click a field and press your desired key combination" FontSize="12" Foreground="#888888"/>
                        <TextBlock Text="Press Escape or click X to clear" FontSize="10" Foreground="#666666"/>
                        <TextBlock Text="Changes require restart to take effect" FontSize="10" Foreground="#FF8800" Margin="0,0,0,10"/>

                        <StackPanel Spacing="5">
                            <TextBlock Text="Toggle Recording (Start/Stop)" FontSize="12" Foreground="#888888"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="ToggleRecordingHotkeyBox" Grid.Column="0" Watermark="Click to set hotkey"
                                         GotFocus="OnHotkeyBoxGotFocus" LostFocus="OnHotkeyBoxLostFocus" KeyDown="OnHotkeyBoxKeyDown"/>
                                <Button Grid.Column="1" Content="✕" Width="28" Height="28" Margin="5,0,0,0"
                                        Click="OnClearHotkeyClick" Tag="ToggleRecording" FontSize="12" Padding="0"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="Pause/Resume" FontSize="12" Foreground="#888888"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="PauseResumeHotkeyBox" Grid.Column="0" Watermark="Click to set hotkey"
                                         GotFocus="OnHotkeyBoxGotFocus" LostFocus="OnHotkeyBoxLostFocus" KeyDown="OnHotkeyBoxKeyDown"/>
                                <Button Grid.Column="1" Content="✕" Width="28" Height="28" Margin="5,0,0,0"
                                        Click="OnClearHotkeyClick" Tag="PauseResume" FontSize="12" Padding="0"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="Open Settings" FontSize="12" Foreground="#888888"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="OpenSettingsHotkeyBox" Grid.Column="0" Watermark="Click to set hotkey"
                                         GotFocus="OnHotkeyBoxGotFocus" LostFocus="OnHotkeyBoxLostFocus" KeyDown="OnHotkeyBoxKeyDown"/>
                                <Button Grid.Column="1" Content="✕" Width="28" Height="28" Margin="5,0,0,0"
                                        Click="OnClearHotkeyClick" Tag="OpenSettings" FontSize="12" Padding="0"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="Toggle-to-Talk (Start/Stop)" FontSize="12" Foreground="#888888"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="LongRecordHotkeyBox" Grid.Column="0" Watermark="Click to set hotkey"
                                         GotFocus="OnHotkeyBoxGotFocus" LostFocus="OnHotkeyBoxLostFocus" KeyDown="OnHotkeyBoxKeyDown"/>
                                <Button Grid.Column="1" Content="✕" Width="28" Height="28" Margin="5,0,0,0"
                                        Click="OnClearHotkeyClick" Tag="LongRecord" FontSize="12" Padding="0"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="Supported modifiers: Cmd, Ctrl, Option, Shift" FontSize="10" Foreground="#666666" Margin="0,10,0,0"/>
                        <TextBlock Text="Supported keys: A-Z, 0-9, F1-F24, Space, Return, etc." FontSize="10" Foreground="#666666"/>

                        <Border BorderBrush="#333333" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,12,0,0">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Push-to-Talk (hold to talk, then submit with Enter)" FontSize="12" Foreground="#888888" FontWeight="SemiBold"/>
                                <ComboBox x:Name="PushToTalkKeysBox" HorizontalAlignment="Stretch"/>
                                <TextBlock Text="Push-to-Talk without Enter (just types the text)" FontSize="12" Foreground="#888888" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <ComboBox x:Name="PushToTalkNoEnterKeysBox" HorizontalAlignment="Stretch"/>
                                <TextBlock Text="Hold the keys to record, release to transcribe. Exit words like &quot;over&quot; don't apply to push-to-talk: they're typed as spoken, and the keys decide whether Enter is pressed. The second set can be the first plus one more key; adding that key at any point while holding means no Enter. Press Escape while holding to cancel: nothing is typed. Modifier keys only (they don't type characters). Requires Input Monitoring permission. Changes require restart."
                                           FontSize="10" Foreground="#666666" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- General Tab -->
            <TabItem Header="General">
                <ScrollViewer Margin="10">
                    <StackPanel Spacing="15">
                        <CheckBox x:Name="StartOnLoginCheck" Content="Start when computer starts"/>
                        <CheckBox x:Name="StartListeningOnLaunchCheck" Content="Start listening when application starts" IsChecked="True"/>
                        <StackPanel Spacing="2" Margin="20,0,0,0">
                            <CheckBox x:Name="StartListeningPausedCheck" Content="Start paused (press Resume to begin)"/>
                            <TextBlock Text="When listening starts, begin paused instead of detecting speech immediately."
                                       FontSize="10" Foreground="#666666" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox x:Name="ShowNotificationsCheck" Content="Show notifications" IsChecked="True"/>

                        <StackPanel Spacing="5" Margin="0,15,0,0">
                            <TextBlock Text="Toggle-to-Talk" FontSize="12" Foreground="#888888" FontWeight="SemiBold"/>
                            <CheckBox x:Name="ShowLongRecordButtonCheck" Content="Show Long Record button on panel" IsVisible="False"/>
                            <StackPanel Spacing="5" Margin="20,5,0,0">
                                <TextBlock Text="Max Duration (minutes):" FontSize="12" Foreground="#888888"/>
                                <NumericUpDown x:Name="MaxLongRecordMinutes" Minimum="5" Maximum="30" Value="30" Increment="5"/>
                                <TextBlock Text="Recording will auto-stop after this duration" FontSize="10" Foreground="#666666"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Config file location:" FontSize="12" Foreground="#666666" Margin="0,20,0,0"/>
                        <TextBlock x:Name="ConfigPathLabel" Text="" FontSize="10" Foreground="#888888" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- History Tab -->
            <TabItem Header="History">
                <Grid RowDefinitions="*,Auto" Margin="10">
                    <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="4" BorderBrush="#333" BorderThickness="1">
                        <ScrollViewer>
                            <ItemsControl x:Name="HistoryList" Margin="5">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#2A2A2A" CornerRadius="4" Padding="10" Margin="0,0,0,5">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding FormattedTime}" FontSize="10" Foreground="#888888"/>
                                                    <TextBlock Text="{Binding PreviewText}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Copy" VerticalAlignment="Center" Click="OnHistoryCopyClick" Tag="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Button Grid.Row="1" Content="Clear All" Click="OnClearHistoryClick" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="15">
            <Button Content="Cancel" Click="OnCancelClick" Width="80" Margin="5"/>
            <Button Content="Save" Click="OnSaveClick" Width="80" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
