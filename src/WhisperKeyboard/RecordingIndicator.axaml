<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WhisperKeyboard.RecordingIndicator"
        Title="Recording"
        Width="500"
        Height="65"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

    <Border Background="#1E1E1E"
            CornerRadius="12"
            BorderBrush="#3C5C3C"
            BorderThickness="1"
            Padding="10,8">
        <Grid ColumnDefinitions="120,*,Auto">
            <!-- Waveform Area -->
            <Border Grid.Column="0"
                    Background="#141414"
                    CornerRadius="4"
                    ClipToBounds="True">
                <Canvas x:Name="WaveformCanvas" />
            </Border>

            <!-- Status Area -->
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText"
                           Text="Listening..."
                           Foreground="#96B496"
                           FontSize="14"
                           FontWeight="Medium"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="TimerText"
                           Text=""
                           Foreground="#64FF64"
                           FontSize="18"
                           FontWeight="Bold"
                           IsVisible="False" />
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                <!-- Long Record Button -->
                <Button x:Name="LongRecordButton"
                        Width="32" Height="32"
                        Background="#323232"
                        BorderThickness="0"
                        CornerRadius="16"
                        Padding="0"
                        ToolTip.Tip="Long Recording"
                        IsVisible="False">
                    <Panel>
                        <!-- Record Icon (red circle) -->
                        <Ellipse x:Name="LongRecordIcon"
                                 Width="12" Height="12"
                                 Fill="#FF4444"
                                 IsVisible="True"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                        <!-- Stop Icon (red square, shown during recording) -->
                        <Rectangle x:Name="LongRecordStopIcon"
                                   Width="10" Height="10"
                                   Fill="#FF4444"
                                   IsVisible="False"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Panel>
                </Button>

                <!-- Pause/Resume Button -->
                <Button x:Name="PauseButton"
                        Width="32" Height="32"
                        Background="#323232"
                        BorderThickness="0"
                        CornerRadius="16"
                        Padding="0"
                        ToolTip.Tip="Pause/Resume">
                    <Panel>
                        <!-- Pause Icon (two bars) -->
                        <StackPanel x:Name="PauseIcon" 
                                    Orientation="Horizontal" 
                                    Spacing="3" 
                                    IsVisible="True"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Rectangle Width="4" Height="12" Fill="#FFC864" />
                            <Rectangle Width="4" Height="12" Fill="#FFC864" />
                        </StackPanel>
                        <!-- Play Icon (triangle) -->
                        <Path x:Name="PlayIcon"
                              Data="M0,0 L0,12 L10,6 Z"
                              Fill="#64FF64"
                              IsVisible="False"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Panel>
                </Button>

                <!-- Stop Button -->
                <Button x:Name="StopButton"
                        Width="32" Height="32"
                        Background="#323232"
                        BorderThickness="0"
                        CornerRadius="16"
                        Padding="0"
                        ToolTip.Tip="Stop">
                    <Rectangle Width="10" Height="10" Fill="#FF6464" />
                </Button>

                <!-- History Button -->
                <Button x:Name="HistoryButton"
                        Width="32" Height="32"
                        Background="#323232"
                        BorderThickness="0"
                        CornerRadius="16"
                        Padding="0"
                        ToolTip.Tip="History">
                    <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12.5,7H11V13L16.2,16.2L17,14.9L12.5,12.2V7Z"
                          Fill="#B4B4B4"
                          Width="16" Height="16"
                          Stretch="Uniform" />
                </Button>

                <!-- Calibrate Button -->
                <Button x:Name="CalibrateButton"
                        Width="32" Height="32"
                        Background="#323232"
                        BorderThickness="0"
                        CornerRadius="16"
                        Padding="0"
                        ToolTip.Tip="Calibrate Mic">
                    <Path Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,7A2,2 0 0,1 14,9A2,2 0 0,1 12,11A2,2 0 0,1 10,9A2,2 0 0,1 12,7M12,13C14.67,13 18,14.33 18,17V18H6V17C6,14.33 9.33,13 12,13Z"
                          Fill="#B4B4B4"
                          Width="16" Height="16"
                          Stretch="Uniform" />
                </Button>

                <!-- Settings Button -->
                <Button x:Name="SettingsButton"
                        Width="32" Height="32"
                        Background="#323232"
                        BorderThickness="0"
                        CornerRadius="16"
                        Padding="0"
                        ToolTip.Tip="Settings">
                    <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                          Fill="#B4B4B4"
                          Width="16" Height="16"
                          Stretch="Uniform" />
                </Button>

                <!-- Pin Button (PTT only - keeps bar visible after PTT) -->
                <Button x:Name="PinButton"
                        Width="32" Height="32"
                        Background="#323232"
                        BorderThickness="0"
                        CornerRadius="16"
                        Padding="0"
                        ToolTip.Tip="Pin (keep bar open)"
                        IsVisible="False">
                    <Path Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z"
                          Fill="#B4B4B4"
                          Width="14" Height="14"
                          Stretch="Uniform" />
                </Button>

                <!-- Retry Button (shown only after transcription failure) -->
                <Button x:Name="RetryButton"
                        Width="32" Height="32"
                        Background="#323232"
                        BorderThickness="0"
                        CornerRadius="16"
                        Padding="0"
                        ToolTip.Tip="Retry transcription"
                        IsVisible="False">
                    <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                          Fill="#64FF96"
                          Width="16" Height="16"
                          Stretch="Uniform" />
                </Button>

                <!-- Discard Button (shown only after transcription failure) -->
                <Button x:Name="DiscardButton"
                        Width="32" Height="32"
                        Background="#323232"
                        BorderThickness="0"
                        CornerRadius="16"
                        Padding="0"
                        ToolTip.Tip="Discard recording"
                        IsVisible="False">
                    <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                          Fill="#FF6464"
                          Width="14" Height="14"
                          Stretch="Uniform" />
                </Button>

                <!-- Save Audio Button (shown only after transcription failure) -->
                <Button x:Name="SaveAudioButton"
                        Width="32" Height="32"
                        Background="#323232"
                        BorderThickness="0"
                        CornerRadius="16"
                        Padding="0"
                        ToolTip.Tip="Save audio to a WAV file"
                        IsVisible="False">
                    <Path Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z"
                          Fill="#96C8FF"
                          Width="14" Height="14"
                          Stretch="Uniform" />
                </Button>

                <!-- Cancel Button (shown only while transcribing) -->
                <Button x:Name="CancelButton"
                        Width="32" Height="32"
                        Background="#323232"
                        BorderThickness="0"
                        CornerRadius="16"
                        Padding="0"
                        ToolTip.Tip="Cancel transcription"
                        IsVisible="False">
                    <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                          Fill="#FFA050"
                          Width="14" Height="14"
                          Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
